				<Source><![CDATA[
[Form]
/// <summary>
/// Lists the Chain of Command wrappers, event handlers and extension classes found in all packages.
/// Opened from the AOT browser it is filtered on the selected object.
/// </summary>
public class ARBCodeExtensions extends FormRun
{
}
]]></Source>
			</Method>
		</Methods>
		<DataSources xmlns="">
			<DataSource>
				<Name>ARBCodeExtensions</Name>
				<Methods>
					<Method>
						<Name>init</Name>
						<Source><![CDATA[
        /// <summary>
        /// Filters on the target object when opened from the AOT browser.
        /// </summary>
        public void init()
        {
            super();

            if (element.args() && element.args().caller() && element.args().caller().name() == formStr(ARBAOTBrowser))
            {
                str targetName = element.args().parm();
                if (targetName)
                {
                    this.queryBuildDataSource().addRange(fieldNum(ARBCodeExtensions, TargetName)).value(queryValue(targetName));
                }
            }
        }

]]></Source>
					</Method>
				</Methods>
